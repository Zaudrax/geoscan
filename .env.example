APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Paris
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- GeoScan / scraping Shodan ---------------------------------------------
SHODAN_BASE_URL=https://www.shodan.io
SHODAN_USER_AGENT="GeoScanBot/1.0 (+projet pedagogique IT-Akademy; contact: contact@example.test)"
# robots.txt de shodan.io annonce Crawl-delay: 10 -> plancher a 10 secondes
SHODAN_REQUEST_DELAY=10
# Reutilise un instantane de moins de 5 minutes plutot que de re-scraper
SHODAN_HOST_COOLDOWN=300
SHODAN_TIMEOUT=20

# --- GeoScan : session Shodan (obligatoire pour les filtres de recherche) ---
# Shodan refuse country:, port:, org:... a un visiteur anonyme. Passe a true,
# fournis une session par l'UNE des deux voies ci-dessous, puis verifie avec :
#     php artisan geoscan:session
SHODAN_LOGIN_ENABLED=false

# Voie 1 (recommandee, marche avec un compte Google) : l'en-tete Cookie recopie
# depuis un navigateur deja connecte a shodan.io. Outils de developpement ->
# onglet Reseau -> une requete vers shodan.io -> En-tetes de requete -> Cookie.
SHODAN_SESSION_COOKIE=

# Voie 2 (compte avec mot de passe uniquement) : rejoue le formulaire de
# connexion. Inutilisable pour un compte cree via « Se connecter avec Google ».
SHODAN_EMAIL=
SHODAN_PASSWORD=

# --- GeoScan : enumeration par decoupage de filtres ---
SHODAN_MAX_REQUESTS_PER_RUN=30

# --- GeoScan : geocodage OSM pour la carte ---
GEOCODING_ENABLED=true
# Geocodeur OSM. Nominatim public refuse les User-Agent identifiables (403) :
# pour l'utiliser il faut une instance auto-hebergee.
# GEOCODING_ENDPOINT=https://photon.komoot.io/api/
